@page "/tasks"
@using TaskFlow.Domain.Entities
@inject HttpClient Http

<h3>Uppgifter</h3>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (tasks is null)
{
    <p><em>Laddar uppgifter från API...</em></p>
}
else if (!tasks.Any())
{
    <p>Inga uppgifter hittades i databasen.</p>
}
else
{
    <table class="table table-striped w-75">
        <thead>
            <tr>
                <th>ID</th>
                <th>Titel</th>
                <th>Beskrivning</th>
                <th>Klar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in tasks)
            {
                <tr>
                    <td>@task.Id</td>
                    <td>@task.Title</td>
                    <td>@task.Description</td>
                    <td>
                        @if (task.IsDone)
                        {
                            <span class="badge bg-success">Ja</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nej</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<TaskItem>? tasks;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Gör ett anrop till TaskItems API-controller
            tasks = await Http.GetFromJsonAsync<List<TaskItem>>("api/TaskItems");
        }
        catch (Exception ex)
        {
            // Fångar upp om API:et inte svarar
            errorMessage = "Kunde inte hämta uppgifter. Kontrollera att API:et körs! Fel: " + ex.Message;
        }
    }
}